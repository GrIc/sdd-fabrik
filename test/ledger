#!/usr/bin/env bash
# Runs template/sdd/bin/ledger against throwaway repos and a fake cockpit. Usage: bash test/ledger [test_name...]
set -u

kit=$(cd "$(dirname "$0")/.." && pwd)
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=Dev GIT_AUTHOR_EMAIL=dev@example.test GIT_COMMITTER_NAME=Dev GIT_COMMITTER_EMAIL=dev@example.test

# A remote, and a clone of it in $tmp/a with the harness and two modules, search and import.
# A fake python3 runs the cockpit: it prints $tmp/usage, keeps the script in $tmp/script and its arguments in $tmp/args.
setup() {
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  mkdir "$tmp/bin"
  printf '#!/bin/sh\n[ "$1" != -c ] || exit 0\necho "$1" > "%s/script"\nshift\n' "$tmp" > "$tmp/bin/python3"
  printf 'echo "$@" > "%s/args"\ncat "%s/usage"\n' "$tmp" "$tmp" >> "$tmp/bin/python3"
  chmod +x "$tmp/bin/python3"
  PATH=$tmp/bin:$PATH
  git -c init.defaultBranch=main init -q --bare "$tmp/origin.git"
  git clone -q "$tmp/origin.git" "$tmp/a" 2> /dev/null && cd "$tmp/a"
  mkdir -p sdd/bin sdd/modules src/search src/import
  cp "$kit/template/sdd/bin/sdd" "$kit/template/sdd/bin/ledger" sdd/bin/
  printf -- '---\ngoverns: [src/search]\n---\n# search\n' > sdd/modules/search.md
  printf -- '---\ngoverns: [src/import]\n---\n# import\n' > sdd/modules/import.md
  echo one | tee src/search/a.py > src/import/a.py
  git add -A
  GIT_COMMITTER_DATE=2026-10-23T10:00:00Z git commit -qm 'Adopt SDD-Fabrik'
  git push -q origin HEAD:main
}

# Commits a change of $1 lines to search and $2 to import at time $3, then records it.
batch() {
  seq "$1" >> src/search/a.py
  seq "$2" >> src/import/a.py
  git add -A
  GIT_COMMITTER_DATE=$3 git commit -qm batch -m 'Agent-Assisted: yes'
  bash sdd/bin/ledger record
}

ledger() { git ls-tree -r "${1:-refs/notes/sdd-ledger}" | awk '{ print $3 }' | git cat-file --batch | grep '^v1'; }
fails() { if [ "$1" != "$2" ]; then printf '    expected: %s\n    got:      %s\n' "$2" "$1"; return 1; fi; }

test_record_splits_a_batch_by_module_on_no_commit() {
  printf 'writer\topus\t4\t40\t400\t4000\t8\n' > "$tmp/usage"
  batch 3 1 2026-10-23T11:00:00Z
  fails "$(cat "$tmp/script")" sdd/bin/cockpit
  fails "$(ledger | tr '\t' ' ')" 'v1 2026-10 import writer opus 1 10 100 1000 2
v1 2026-10 search writer opus 3 30 300 3000 6'
  fails "$(git log -1 --format='%an %aI %cI' refs/notes/sdd-ledger)" \
    'sdd-fabrik 2026-10-01T00:00:00+00:00 2026-10-01T00:00:00+00:00'
  ! git notes --ref sdd-ledger list HEAD 2> /dev/null
}

test_a_batch_outside_the_modules_goes_to_a_dash() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  echo doc > README.md
  git add -A
  git commit -qm doc
  bash sdd/bin/ledger record
  fails "$(ledger | cut -f3)" '-'
}

test_an_amend_counts_from_the_last_record() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T11:00:00Z
  GIT_COMMITTER_DATE=2026-10-23T12:00:00Z git commit -q --amend -m again
  bash sdd/bin/ledger record
  fails "$(cut -d' ' -f3-4 "$tmp/args")" '1792753200 1792756800'
}

test_a_failed_cockpit_loses_no_window() {
  cp "$tmp/bin/python3" "$tmp/python3"
  printf '#!/bin/sh\n[ "$1" = -c ]\n' > "$tmp/bin/python3"
  ! batch 1 0 2026-10-23T11:00:00Z
  cp "$tmp/python3" "$tmp/bin/python3"
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T12:00:00Z
  fails "$(cut -d' ' -f3-4 "$tmp/args")" '1792749600 1792756800'
}

# As Windows answers before Python is installed.
test_record_without_python_notes_nothing() {
  printf '#!/bin/sh\nexit 9009\n' > "$tmp/bin/python3"
  batch 1 0 2026-10-23T11:00:00Z
  ! git rev-parse -q --verify refs/notes/sdd-ledger
}

test_a_dev_who_turns_it_off_notes_nothing() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  git config sdd.ledger false
  batch 1 0 2026-10-23T11:00:00Z
  ! git rev-parse -q --verify refs/notes/sdd-ledger
}

test_sync_merges_two_devs_ledgers() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T11:00:00Z
  git clone -q "$tmp/origin.git" "$tmp/b" 2> /dev/null
  bash sdd/bin/ledger sync
  cd "$tmp/b"
  printf 'reviewer\tsonnet\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 0 1 2026-10-23T12:00:00Z
  bash sdd/bin/ledger sync
  git fetch -q origin refs/notes/sdd-ledger:refs/remotes/ledger
  fails "$(ledger refs/remotes/ledger | cut -f3-4 | sort | tr '\t' ' ')" 'import reviewer
search writer'
}

test_sync_without_a_ledger_fetches_nothing() {
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T11:00:00Z
  bash sdd/bin/ledger sync
  git clone -q "$tmp/origin.git" "$tmp/b" 2> /dev/null && cd "$tmp/b"
  bash sdd/bin/ledger sync
  ! git rev-parse -q --verify refs/notes/sdd-ledger-remote
}

test_installed_hooks_record_and_share_the_ledger() {
  bash sdd/bin/sdd install-hook > /dev/null
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  echo two >> src/search/a.py
  git add -A
  git commit -qm 'Change search' 2> /dev/null
  git push -q origin HEAD:main
  git ls-remote --exit-code origin refs/notes/sdd-ledger > /dev/null
}

test_report_sums_by_month_module_role_and_model_then_shows_coverage() {
  printf 'writer\topus\t4\t40\t400\t4000\t8\n' > "$tmp/usage"
  batch 3 1 2026-10-23T11:00:00Z
  printf 'writer\topus\t1\t1\t1\t1\t1\n' > "$tmp/usage"
  batch 1 0 2026-10-23T12:00:00Z
  printf 'reviewer\tsonnet\t1\t2\t3\t4\t5\n' > "$tmp/usage"
  batch 1 0 2026-11-02T10:00:00Z
  GIT_COMMITTER_DATE=2026-11-02T11:00:00Z git commit -q --allow-empty -m 'Not noted' -m 'Agent-Assisted: yes'
  GIT_COMMITTER_DATE=2026-11-02T12:00:00Z git commit -q --allow-empty -m 'Not noted' \
    -m 'Co-Authored-By: Claude <noreply@anthropic.com>'
  fails "$(bash sdd/bin/ledger report | tr '\t' ' ')" 'month module role model calls input output cache_read cache_write
2026-10 import writer opus 1 10 100 1000 2
2026-10 search writer opus 4 31 301 3001 7
2026-11 search reviewer sonnet 1 2 3 4 5

month batches agent_commits
2026-10 2 2
2026-11 1 3'
}

test_report_without_a_ledger_says_how_to_fetch_it() {
  ! bash sdd/bin/ledger report 2> "$tmp/err"
  grep -qF 'git fetch origin refs/notes/sdd-ledger:refs/notes/sdd-ledger' "$tmp/err"
}

test_ledger_survives_a_crlf_checkout() {
  cp "$kit/template/.gitattributes" .gitattributes
  git add -A
  git commit -qm 'Pin line ends'
  git config core.autocrlf true
  rm sdd/bin/ledger
  git checkout -- sdd/bin/ledger
  ! bash sdd/bin/ledger report 2> "$tmp/err"
  grep -qF 'No token ledger here.' "$tmp/err"
}

names=${*:-$(declare -F | awk '$3 ~ /^test_/ { print $3 }')}
failed=0
for t in $names; do
  ( set -e; setup; "$t" )
  # Quiet when green: the agent that runs the tests reads every line.
  if [ $? -ne 0 ]; then echo "FAIL $t"; failed=$((failed + 1)); fi
done
echo "$failed failed of $(wc -w <<< "$names" | tr -d ' ')"
[ "$failed" -eq 0 ]
