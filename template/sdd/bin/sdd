#!/usr/bin/env bash
# SDD-Fabrik checks: drift between contracts and code, batch size, and the quiz. See sdd/WORKFLOW.md.
set -euf  # f: governs paths go to git as pathspecs, the shell must not expand them

# An agent batch up to 5% over only gets a note.
MAX_LINES=200

# Co-author addresses that mark an agent batch, as an ERE alternation. Names are not enough: Claude is also a
# first name. Any agent can mark its batch with Agent-Assisted: yes.
AGENT_EMAILS='noreply@anthropic\.com|noreply@openai\.com|aider@aider\.chat'

EMPTY_TREE=$(git hash-object -t tree --stdin < /dev/null)

# Paths with accents print as they are, not as quoted octal escapes.
git() { command git -c core.quotePath=false "$@"; }

is_agent() {
  grep -Eiq "^Agent-Assisted:[[:space:]]*yes[[:space:]]*\$|^Co-Authored-By:.*<($AGENT_EMAILS)>" <<< "$1"
}

# Paths listed in a contract's governs, one per line. $1 is a revision path such as HEAD:sdd/modules/search.md.
governs() {
  git show "$1" | tr -d "\r\"'" | awk '
    /^---[[:space:]]*$/ { fm++; next }
    fm == 1 && /^governs:/ { on = 1 }
    fm == 1 && on {
      last = /\]/
      sub(/^governs:[[:space:]]*/, "")
      gsub(/[][,]/, " ")
      for (i = 1; i <= NF; i++) print $i
      if (last) on = 0
    }'
}

# Whether the contract at revision path $1 declares risk: high.
risky() {
  git show "$1" 2> /dev/null | tr -d '\r' |
    awk '/^---[[:space:]]*$/ { fm++; next } fm == 1 && /^risk:[[:space:]]*high[[:space:]]*$/ { f = 1 } END { exit !f }'
}

modules() {
  git ls-tree --name-only "$1" sdd/modules/ | awk -F/ 'sub(/\.md$/, "", $NF) { printf "%s%s", sep, $NF; sep = ", " }'
}

# The modules whose code or contract commit $1 changes, each with its changed lines, tab-separated.
touched() {
  local parent contract
  parent=$(git rev-parse -q --verify "$1^" || echo "$EMPTY_TREE")
  for contract in $(git ls-tree -r --name-only "$1" sdd/modules/ | awk '/\.md$/'); do
    git diff --numstat --no-renames "$parent" "$1" -- "$contract" $(governs "$1:$contract") |
      awk -F '\t' -v module="$(basename "$contract" .md)" '
        $1 != "-" { n += $1 + $2 }
        END { if (n) print module "\t" n }'
  done
}

# Checks the change from $1 to $2 (commits or trees) under the commit message $3.
# Sets changed (the changed files), hit (the modules whose code or contract changed, joined by ","), high (those of
# them at high risk), level (low, normal or high), errors (fatal for everyone), findings (fatal for agents only) and
# notes.
check() {
  local base=$1 tree=$2 msg=$3 module contract paths path drift touched=0 lines
  errors= findings= notes= hit= high=
  changed=$(git diff --name-only --no-renames "$base" "$tree")
  for module in $(sed -n 's/^Spec-Unchanged(\([^)]*\)):.*/\1/p' <<< "$msg"); do
    git cat-file -e "$tree:sdd/modules/$module.md" 2> /dev/null ||
      errors="${errors}ERROR Spec-Unchanged($module): no such module. Modules: $(modules "$tree").
"
  done
  for contract in $(git ls-tree -r --name-only "$tree" sdd/modules/ | awk '/\.md$/'); do
    module=$(basename "$contract" .md)
    paths=$(governs "$tree:$contract")
    if [ -z "$paths" ]; then
      errors="${errors}ERROR $contract: governs is empty. List the paths this module owns.
"
      continue
    fi
    drift=$(links "$tree" "$contract")
    [ -z "$drift" ] || findings="${findings}$drift
      Fix the link, or the name of the test it points to.
"
    path=$(git diff --name-only --no-renames "$base" "$tree" -- $paths | head -n 1)
    if [ -n "$path" ] || grep -qxF "$contract" <<< "$changed"; then
      hit=$hit${hit:+,}$module
      # The batch that drops risk: high is still judged at high risk.
      if risky "$tree:$contract" || risky "$base:$contract"; then high=$high${high:+, }$module; fi
    fi
    [ -n "$path" ] || continue
    grep -q "^Spec-Unchanged($module):[[:space:]]*[^[:space:]]" <<< "$msg" && continue
    touched=$((touched + 1))
    grep -qxF "$contract" <<< "$changed" && continue
    findings="${findings}DRIFT $contract: $path changed, its contract did not.
      Update the contract if the code is right, fix the code if it betrays the intent,
      or add 'Spec-Unchanged($module): <reason>' to the message if the behavior is unchanged.
"
  done
  # Prose outside the contracts asks little of a quiz: the human reads its diff.
  level=normal
  if [ -n "$high" ]; then
    level=high
  elif [ -n "$changed" ] && ! grep -qv '\.md$' <<< "$changed" && ! grep -q '^sdd/modules/' <<< "$changed"; then
    level=low
  fi
  lines=$(git diff --numstat --no-renames "$base" "$tree" |
    awk -F '\t' '$1 != "-" && $3 !~ /(\.md|\.lock|lock\.json|lock\.yaml)$/ { n += $1 + $2 } END { print n + 0 }')
  if grep -q '^Large-Batch:[[:space:]]*[^[:space:]]' <<< "$msg"; then
    [ "$lines" -le "$MAX_LINES" ] ||
      notes="${notes}NOTE $lines changed lines of code and tests, over $MAX_LINES: Large-Batch lifts it.
"
    [ "$touched" -le 1 ] || notes="${notes}NOTE the batch changes code of $touched modules: Large-Batch lifts it.
"
    return 0
  fi
  if [ "$lines" -gt $((MAX_LINES * 105 / 100)) ]; then
    findings="${findings}SIZE $lines changed lines of code and tests, over $MAX_LINES by more than 5%.
      Split the batch, or the human adds 'Large-Batch: <reason>' to the message.
"
  elif [ "$lines" -gt "$MAX_LINES" ]; then
    notes="${notes}NOTE $lines changed lines of code and tests, over $MAX_LINES but within 5%.
"
  fi
  if [ "$touched" -gt 1 ]; then
    findings="${findings}SIZE the batch changes code of $touched modules.
      Split it by module, or the human adds 'Large-Batch: <reason>' to the message.
"
  fi
}

report() {
  printf '%s' "$notes" >&2
  if [ -n "$errors" ]; then
    printf '%s' "$errors$findings" >&2
    return 1
  fi
  [ -n "$findings" ] || return 0
  if is_agent "$1"; then
    printf 'Refused, agent-assisted batch:\n%s' "$findings" >&2
    return 1
  fi
  printf 'Warnings only, this is your own commit:\n%s' "$findings" >&2
}

fingerprint() {
  printf '%s %s' "$(git write-tree)" "$(git rev-parse -q --verify HEAD || echo none)" | git hash-object --stdin
}

quiz_key() { git rev-parse --git-path sdd/quiz-key; }

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

# One line per question of QUIZ.md: its number, boxes, ticked boxes, the ticked letter and what its See cites.
questions() {
  tr -d '\r' < QUIZ.md | awk '
    /^## / { q++; boxes[q] = 0; ticks[q] = 0; pick[q] = "-"; see[q] = "-"; next }
    q && /^See / { see[q] = substr($0, 5) }
    q && /^- \[[ xX]\]/ { boxes[q]++; if (/^- \[[xX]\]/) { ticks[q]++; pick[q] = substr("ABCD", boxes[q], 1) } }
    END { for (i = 1; i <= q; i++) print i, boxes[i], ticks[i], pick[i], see[i] }'
}

# The reviewer's part: QUIZ.md and its key fit the staged batch. Sets count, the questions a quiz needs, and ranks,
# the right letters in order. Needs changed and level, set by check.
quiz_form() {
  local key i boxes ticks pick see answer letters=ABCD
  key=$(quiz_key)
  ranks=
  count=3
  [ "$level" != high ] || count=5
  [ -f "$key" ] || fail "QUIZ.md has no key: the reviewer writes it at $key (see sdd/WORKFLOW.md)."
  [ "$(head -n 1 "$key" | tr -d '\r')" = "$(fingerprint)" ] ||
    echo 'NOTE The batch changed since the quiz was written. If your changes touch what it asks, ask for a new one.' >&2
  [ "$(grep -c '^## ' QUIZ.md)" -eq "$count" ] || fail "QUIZ.md needs $count questions, each under a \"## \" heading."
  while read -r i boxes ticks pick see; do
    grep -qxF "${see%%:*}" <<< "$changed" ||
      fail "Question $i needs a 'See <file>:<line>' line pointing to a file of this batch."
    [ "$boxes" -ge 2 ] && [ "$boxes" -le 4 ] || fail "Question $i needs 2 to 4 boxes."
    answer=$(sed -n "$((i + 1))p" "$key" | tr -d '\r')
    answer=${answer%% *}
    case ${letters:0:$boxes} in *"$answer"*) ;; *) answer= ;; esac
    [ ${#answer} -eq 1 ] ||
      fail "Question $i has no right box in the key: line $((i + 1)) starts with its letter, A for the first box."
    ranks=$ranks$answer
  done <<< "$(questions)"
}

# Writes under each wrong question of QUIZ.md a quoted block, which the parser skips: its tries, the key's hint, and
# optional boxes for the dev to say why. A new try counts up and keeps what the dev ticked and wrote.
# $1: one line per wrong question, its number, a tab and its hint.
feedback() {
  tr -d '\r' < QUIZ.md | WRONG=$1 awk '
    BEGIN {
      n = split(ENVIRON["WRONG"], rows, "\n")
      for (i = 1; i <= n; i++) if (split(rows[i], f, "\t") == 2) hint[f[1]] = f[2]
      split("I had not understood the code|The question is unclear|The code does not do what I wanted: check" \
        " this box and type *quiz feedback* to your agent to clarify", causes, "|")
    }
    function flush(   i, last, tries) {
      if (!(q in hint)) { for (i = 1; i <= lines; i++) print buf[i]; lines = 0; return }
      tries = 1
      for (i = 1; i <= lines; i++) {
        if (buf[i] ~ /^> Wrong, [0-9]+ tr/) { split(buf[i], w, " "); tries = w[3] + 1 }
        if (buf[i] ~ /^> - \[[xX]\] /) ticked[substr(buf[i], 9)] = 1
        if (buf[i] ~ /^> - Other:/) other = substr(buf[i], 11)
      }
      for (last = lines; last > 0 && (buf[last] == "" || buf[last] ~ /^>/); last--) ;
      for (i = 1; i <= last; i++) print buf[i]
      print ""
      printf "> Wrong, %d %s.%s\n", tries, tries == 1 ? "try" : "tries", hint[q] == "" ? "" : " Hint: " hint[q]
      if (tries > 1) printf "> %d tries on this question: type *quiz feedback* to your agent to clear it up.\n", tries
      print ">"
      print "> Optional, why? (shared without your name)"
      for (i = 1; i <= 3; i++) printf "> - [%s] %s\n", ticked[causes[i]] ? "x" : " ", causes[i]
      print "> - Other:" other
      if (!end) print ""
      lines = 0; other = ""; delete ticked
    }
    /^## / { flush(); q++ }
    { buf[++lines] = $0 }
    END { end = 1; flush() }' > QUIZ.tmp
  mv QUIZ.tmp QUIZ.md
}

# Appends to the quiz journal one line per question of this try, of kind $1 (try or pass), $2 telling right from wrong
# answers (R or W, one per question). The journal stays on this machine, shared by the clone's worktrees; the ledger
# and the cockpit read it.
journal() {
  local file
  file=$(git rev-parse --git-common-dir)/sdd/quiz-journal
  mkdir -p "$(dirname "$file")"
  tr -d '\r' < QUIZ.md | awk -v kind="$1" -v grades="$2" -v now="$(date +%s)" -v fp="$(fingerprint)" \
    -v modules="${hit:--}" '
    function cause(name) { causes = causes (causes == "" ? "" : ",") name }
    function out() {
      if (!q) return
      gsub(/\t/, " ", title)
      gsub(/\t/, " ", other)
      printf "v1\t%s\t%s\t%s\t%s\t%d\t%d\t%s\t%s\t%s\n", now, kind, fp, modules, q,
        wrong + (substr(grades, q, 1) == "R"), causes == "" ? "-" : causes, title, other == "" ? "-" : other
    }
    /^## / { out(); q++; title = $0; sub(/^## ([0-9]+\. )?/, "", title); wrong = 0; causes = other = ""; next }
    /^> Wrong, [0-9]+ tr/ { split($0, w, " "); wrong = w[3] }
    /^> - \[[xX]\] I had not understood/ { cause("not-understood") }
    /^> - \[[xX]\] The question is unclear/ { cause("unclear") }
    /^> - \[[xX]\] The code does not do/ { cause("not-wanted") }
    /^> - Other:/ { other = substr($0, 11); sub(/^[[:space:]]+/, "", other) }
    END { out() }' >> "$file"
}

# Checks the boxes ticked in QUIZ.md against the reviewer's key. Needs changed and hit, set by check.
quiz() {
  local key wrong= grades= i boxes ticks pick see expected hint
  key=$(quiz_key)
  [ -f QUIZ.md ] ||
    fail 'No quiz for this agent-assisted batch: ask the fresh reviewer for QUIZ.md (see sdd/WORKFLOW.md).'
  quiz_form
  while read -r i boxes ticks pick see; do
    [ "$ticks" -eq 1 ] || fail "Tick exactly one box for question $i in QUIZ.md, save, then commit again."
    expected=$(sed -n "$((i + 1))p" "$key" | tr -d '\r')
    if [ "$pick" = "${expected%% *}" ]; then
      grades=${grades}R
    else
      grades=${grades}W
      hint=${expected:1}
      wrong="$wrong$i	${hint# }
"
      echo "Question $i is wrong: a hint is in QUIZ.md." >&2
    fi
  done <<< "$(questions)"
  if [ -z "$wrong" ]; then
    journal pass "$grades"
    return 0
  fi
  feedback "$wrong"
  journal try "$grades"
  fail "$((count - $(grep -c . <<< "$wrong")))/$count. Fix your answers in QUIZ.md, save, then commit again."
}

# Drift between contract $2 and the tests it links, in tree $1: a linked file the tree lacks, or a name the file lacks.
links() {
  local link text target file
  git show "$1:$2" | tr '\r\n' '  ' | tr -s ' ' | grep -o '\[[^]]*\]([^)]*)' | while IFS= read -r link; do
    text=${link#[}
    text=${text%%](*}
    target=${link#*](}
    target=${target%)}
    target=${target%%#*}
    case $target in '' | *:* | *.md | */) continue ;; esac
    # A target is relative to the contract, or starts at the repo root.
    case $target in
      /*) file=$(git ls-tree --name-only "$1" -- "${target#/}" 2> /dev/null) ;;
      *) file=$(git -C "${2%/*}" ls-tree --full-name --name-only "$1" -- "$target" 2> /dev/null) ;;
    esac
    if [ -z "$file" ]; then
      echo "DRIFT $2: links \"$text\" to $target, a file the commit does not have."
    elif [ "$(git cat-file -t "$1:$file")" = blob ] && [ "$text" != "${file##*/}" ] && [ "$text" != "$file" ] &&
      ! git show "$1:$file" | grep -qwF -- "$text"; then
      echo "DRIFT $2: links \"$text\", not found in $file."
    fi
  done
}

# Guidance for the agent, never a refusal: governs paths that match nothing, and the project's markdown against the
# code it governs (WORKFLOW.md and guide/ are the kit's).
guidance() {
  local contract path paths= md code
  for contract in $(git ls-files 'sdd/modules/*.md'); do
    for path in $(governs ":$contract"); do
      paths="$paths $path"
      [ -n "$(git ls-files -- "$path" | head -n 1)" ] ||
        echo "NOTE $contract: $path matches no tracked file, a typo or code still to come."
    done
  done
  md=$(git grep -I -h -c -v -e '^[[:space:]]*$' -- 'sdd/*.md' AGENTS.md ':!sdd/WORKFLOW.md' ':!sdd/guide/' |
    awk '{ n += $1 } END { print n + 0 }')
  if [ -z "$paths" ]; then
    echo "NOTE $md lines of markdown, no contract yet."
    return
  fi
  code=$(git grep -I -h -c -v -e '^[[:space:]]*$' -- $paths ':!*.md' | awk '{ n += $1 } END { print n + 0 }')
  LC_ALL=C awk -v md="$md" -v code="$code" 'BEGIN {
    printf "NOTE %d lines of markdown for %d lines of governed code, ratio %.2f (guideline: at most 1).\n",
      md, code, code ? md / code : 0 }'
}

hook() {
  local msg base
  # Finishing a merge: its commits were checked one by one.
  [ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ] || return 0
  msg=$(grep -v '^#' "$1" || true)
  base=$(git rev-parse -q --verify HEAD || echo "$EMPTY_TREE")
  check "$base" "$(git write-tree)" "$msg"
  report "$msg" || exit 1
  is_agent "$msg" || return 0
  # A reword or an amend that changes no file leaves nothing to quiz on.
  [ -n "$changed" ] || return 0
  [ "$level" != low ] || [ -f QUIZ.md ] || return 0
  quiz
  git interpret-trailers --in-place --trailer "Quiz: $count/$count" "$1"
  rm -f QUIZ.md "$(quiz_key)"
}

# Without a message file, the batch is judged as an agent's with no trailers.
audit_staged() {
  local msg='Agent-Assisted: yes' base status=0
  [ -z "${1:-}" ] || msg=$(cat "$1")
  base=$(git rev-parse -q --verify HEAD || echo "$EMPTY_TREE")
  check "$base" "$(git write-tree)" "$msg"
  report "$msg" || status=1
  [ -z "$high" ] ||
    echo "NOTE $high: high risk, the quiz asks five questions and a second human's reading is recommended." >&2
  # The reviewer checks its quiz here, so that a malformed one never reaches the human.
  if [ -f QUIZ.md ]; then
    (
      quiz_form
      [ -n "${ranks//${ranks:0:1}/}" ] ||
        echo "NOTE QUIZ.md: the right answer is box ${ranks:0:1} every time, vary it." >&2
    ) || status=1
  fi
  [ "$status" -ne 0 ] || echo 'OK: the staged batch passes the checks.'
  guidance
  return $status
}

# CI: each commit of the range, with its own message.
audit_range() {
  local base=${1%%..*} tip=${1#*..} commits c parent msg status=0
  # A base git does not know (a new branch, a force-push) audits the tip only.
  if git cat-file -e "$base^{commit}" 2> /dev/null; then
    commits=$(git rev-list --reverse --no-merges "$1")
  else
    commits=$(git rev-parse "$tip")
  fi
  for c in $commits; do
    # Commits from before the harness was adopted are not its business.
    git cat-file -e "$c:sdd/bin/sdd" 2> /dev/null || continue
    parent=$(git rev-parse -q --verify "$c^" || echo "$EMPTY_TREE")
    msg=$(git log -1 --format=%B "$c")
    check "$parent" "$c" "$msg"
    if report "$msg"; then
      echo "OK   $(git log -1 --format='%h %s' "$c")"
    else
      echo "FAIL $(git log -1 --format='%h %s' "$c")"
      status=1
    fi
  done
  return $status
}

# Runs a command and keeps its output short for the agent: one line when it passes, its last 30 lines when it fails.
quiet() {
  local log status=0
  log=$(mktemp)
  "$@" > "$log" 2>&1 || status=$?
  if [ "$status" -eq 0 ]; then
    echo "ok: $* ($(wc -l < "$log" | tr -d ' ') lines hidden)"
  else
    tail -n 30 "$log"
    echo "FAIL ($status): $*"
  fi
  rm -f "$log"
  return "$status"
}

# Writes hook $1 with line $2, or prints the line for a hook it did not write. The line passes in a repo without the
# script, such as an older branch or another repo sharing the hook.
install_one() {
  local hook
  hook=$(git rev-parse --git-path hooks)/$1
  if git config core.hooksPath > /dev/null || { [ -e "$hook" ] && ! grep -q '^# sdd-fabrik$' "$hook"; }; then
    echo "Your $1 hook is $hook, or the file your hook manager builds it from. Add this line to it:" >&2
    echo "$2" >&2
    return 1
  fi
  mkdir -p "$(dirname "$hook")"
  printf '#!/bin/sh\n# sdd-fabrik\n%s\n' "$2" > "$hook"
  chmod +x "$hook"
  echo "Installed $hook."
}

# The quiz checks each commit; the token ledger notes each commit and is shared at each push.
install_hook() {
  local exclude status=0
  exclude=$(git rev-parse --git-path info/exclude)
  mkdir -p "$(dirname "$exclude")"
  grep -qx '/QUIZ.md' "$exclude" 2> /dev/null || echo '/QUIZ.md' >> "$exclude"
  install_one commit-msg '[ ! -f sdd/bin/sdd ] || bash sdd/bin/sdd hook "$1" || exit 1' || status=1
  install_one post-commit '[ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger record' || status=1
  install_one pre-push '[ ! -f sdd/bin/ledger ] || bash sdd/bin/ledger sync "$1"' || status=1
  echo 'The token ledger notes what agents spend on each module, never who: git config sdd.ledger false stops it.'
  return $status
}

case ${1:-} in
  hook) hook "$2" ;;
  audit)
    case ${2:-} in
      --message) audit_staged "$3" ;;
      --range) audit_range "$3" ;;
      *) audit_staged ;;
    esac ;;
  fingerprint)
    mkdir -p "$(dirname "$(quiz_key)")"
    echo "fingerprint: $(fingerprint)"
    echo 'quiz: QUIZ.md'
    echo "key: $(quiz_key)" ;;
  install-hook) install_hook ;;
  touched) touched "${2:-HEAD}" ;;
  quiet) shift && quiet "$@" ;;
  *)
    echo 'usage: bash sdd/bin/sdd hook <message-file> | audit [--message <file> | --range <base>..<tip>]' >&2
    echo '       bash sdd/bin/sdd fingerprint | install-hook | touched [<commit>] | quiet <command>...' >&2
    exit 2 ;;
esac
